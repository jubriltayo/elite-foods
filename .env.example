NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Bypasses RLS, so it must only
# ever be used from trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 — Google OAuth via Auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Phase 3 — mobile API bearer tokens
#
# Signs the access tokens this app issues to the mobile app. NOT the same as
# AUTH_SECRET, and must not be: separate secrets mean compromising one does not
# compromise the other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# At least 32 characters.
API_TOKEN_SECRET=

# Optional. Who these tokens are issued by, and for what. Both are verified on
# every request, so a token minted for another purpose or another environment is
# refused. Defaults shown; set only to override.
# API_TOKEN_ISSUER=http://localhost:3000
# API_TOKEN_AUDIENCE=elite-foods-api

# Optional, comma-separated. Extra Google OAuth client ids whose ID tokens are
# accepted, for the Android and iOS clients once they exist. Leave empty until
# then: GOOGLE_CLIENT_ID above is always accepted, so local testing needs no
# additional Google credentials.
GOOGLE_EXTRA_CLIENT_IDS=

# Phase 7 — Mailgun confirmation email
MAILGUN_BASE_URL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
