NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Bypasses RLS, so it must only
# ever be used from trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4 — Google OAuth via Auth.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Phase 7 — Mailgun confirmation email
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
